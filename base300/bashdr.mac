        .Z80
        ASEG
        ORG     2680H

        INCLUDE MSX.INC


        PUBLIC  INIENT

        EXTRN   INIT
        EXTRN   SYNCHR
        EXTRN   CHRGTR
        EXTRN   GETYPR


; START	SUBTTL	BASHDR

	SUBTTL	BASHDR

; Some sort of jumptable for routines in basicrom


; entrypoint for BASIC interpreter init

INIENT:
A2680:  jp      INIT

; entrypoint for SYNCHR
	jp      SYNCHR

; entrypoint for CHRGTR
A2686:  jp      CHRGTR

; entrypoint for GETYPR
A2689:  jp      GETYPR


; END	SUBTTL	BASHDR

        end
